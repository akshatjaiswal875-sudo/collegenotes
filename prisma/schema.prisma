generator client {
  provider = "prisma-client-js"
}

// Force schema update
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("STUDENT") // STUDENT or ADMIN
  mobile        String?
  branch        String?
  year          String?
  accounts      Account[]
  sessions      Session[]
  visitLogs     VisitLog[]
  bookmarks     Bookmark[]
  uploadedNotes Note[]
  feedbacks     Feedback[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subject {
  id     String  @id @default(cuid())
  name   String  @unique
  code   String?
  branch String?
  year   String?
  notes  Note[]
}

model Note {
  id          String   @id @default(cuid())
  title       String
  chapter     String
  driveLink   String
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  createdAt   DateTime @default(now())
  type        String   @default("NOTE") // NOTE or QP (Question Paper)
  status      String   @default("APPROVED") // APPROVED, PENDING, REJECTED
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])
  bookmarks   Bookmark[]
}

model VisitLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  timestamp DateTime @default(now())
  page      String?
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  noteId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // APPROVE_NOTE, REJECT_NOTE, DELETE_NOTE, CREATE_NOTE, UPDATE_NOTE, DELETE_USER, UPDATE_USER_ROLE, CREATE_SUBJECT, UPDATE_SUBJECT, DELETE_SUBJECT
  entityType  String   // NOTE, USER, SUBJECT
  entityId    String   // ID of the affected entity
  entityName  String?  // Name/title for display purposes
  details     String?  // Additional JSON details
  adminId     String   // Who performed the action
  adminName   String?  // Admin name for display
  adminEmail  String?  // Admin email for display
  timestamp   DateTime @default(now())
  
  @@index([adminId])
  @@index([entityType])
  @@index([timestamp])
}

model Feedback {
  id         String   @id @default(cuid())
  userId     String
  rating     Int
  message    String
  createdAt  DateTime @default(now())
  isPublic   Boolean  @default(false)  // Shown on landing/dashboard testimonials
  isApproved Boolean  @default(false)  // Admin approved for public display
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isPublic, isApproved])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // NEW_NOTE, NOTE_APPROVED, ANNOUNCEMENT
  title     String
  message   String
  data      String?  // JSON with noteId, subjectId, etc.
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String   // Public key
  auth      String   // Auth secret
  createdAt DateTime @default(now())

  @@index([userId])
}

